# ============================================================
# Hermes SEO Agent — referência de configuração (NÃO commite .env)
# Padrão de auth espelha unicornio-agent (Application Passwords).
# ============================================================

# ---------- WordPress (fonte de conteúdo) ----------
# Local (Devilbox Docker):
WORDPRESS_URL=http://wordpress.dvl.to:8080
# Produção:
# WORDPRESS_URL=https://prod.unicorniohater.com.br
WORDPRESS_API_BASE=/wp-json/wp/v2
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=

# ---------- Site estático publicado (Eleventy) ----------
STATIC_SITE_URL=https://www.unicorniohater.com.br
# Local (static server): http://localhost:8081
SITEMAP_URL=https://www.unicorniohater.com.br/sitemap_index.xml

# ---------- Google (Fases 2-3) ----------
# Service Account com acesso ao Search Console (e GA4 se usar engajamento):
#   pip install 'hermes-seo-agent[google]'
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Propriedade do Search Console: formato de domínio OU url-prefix:
#   GSC_SITE_URL=sc-domain:unicorniohater.com.br        (domain property)
#   GSC_SITE_URL=https://www.unicorniohater.com.br/     (url-prefix property)
GSC_SITE_URL=sc-domain:unicorniohater.com.br
# GOOGLE_API_KEY: chave compartilhada usada por PageSpeed e CrUX (APIs que
# aceitam API key). A Search Console API NÃO aceita API key — ela usa o
# Service Account acima. PAGESPEED_API_KEY / CRUX_API_KEY sobrescrevem.
GOOGLE_API_KEY=
PAGESPEED_API_KEY=
CRUX_API_KEY=
GA4_PROPERTY_ID=

# ---------- Orçamento URL Inspection (Fase 2) ----------
URL_INSPECTION_DAILY_BUDGET=1800
URL_INSPECTION_GRACE_PERIOD_HOURS=24
SEARCH_ANALYTICS_DAYS=28

# ---------- Alertas (Fase 5) ----------
ALERT_WEBHOOK_URL=
ALERT_HIGH_THRESHOLD=10

# ---------- Segurança / modo ----------
DRY_RUN=true
HTTP_TIMEOUT=15
MAX_REDIRECT_HOPS=5
MAX_URLS_PER_RUN=500
MAX_SAFE_FIX_PER_CYCLE=10

# ---------- Estado ----------
SQLITE_PATH=./state/seo_agent.db
